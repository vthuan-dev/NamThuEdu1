# Midscene AI — copy thành .env và điền API key
# Lấy key tại: https://console.anthropic.com/settings/keys

MIDSCENE_MODEL_PROVIDER=anthropic
MIDSCENE_ANTHROPIC_API_KEY=sk-ant-api03-...

# Hoặc dùng OpenAI
# MIDSCENE_MODEL_PROVIDER=openai
# MIDSCENE_OPENAI_API_KEY=sk-...

# Hoặc dùng Gemini (miễn phí tier)
# MIDSCENE_MODEL_PROVIDER=google
# MIDSCENE_GOOGLE_API_KEY=...
